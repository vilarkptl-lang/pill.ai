# pill.ai environment configuration
# Copy to .env and fill in your values

# ── License ───────────────────────────────────────────────────────────────
PILLAI_LICENSE_KEY=PILLAI-XXXX-XXXX-XXXX-XXXX
# PILLAI_LICENSE_SERVER=https://license.pill.ai   # change only if self-hosting

# ── LLM API Keys ─────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-...
GEMINI_API_KEY=AIza...
OPENAI_API_KEY=sk-...   # fallback only

# ── License Server (only needed if you host it) ───────────────────────────
PILLAI_ADMIN_SECRET=change-me-in-production
PILLAI_DB=/data/license.db

# ── Optional tuning ───────────────────────────────────────────────────────
PILLAI_GRACE_DAYS=7
PILLAI_CACHE_DIR=~/.pill.ai
