# pill.ai environment configuration
# Copy to .env and fill in your values — NEVER commit .env to git

# ── Admin ──────────────────────────────────────────────────────────────────
PILLAI_ADMIN_SECRET=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────
# MySQL (production):
PILLAI_DB_URL=mysql+pymysql://pillai_user:password@localhost/pillai_db
# SQLite (local dev, default if PILLAI_DB_URL not set):
# PILLAI_DB_URL=sqlite:///license.db

# ── LLM API Keys (owner only — users never see these) ────────────────────
GEMINI_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...   # optional fallback

# ── Model routing (change without rebuilding the .exe) ────────────────────
PILLAI_MODEL_FAST=gemini/gemini-2.0-flash-exp
PILLAI_MODEL_MEDIUM=deepseek/deepseek-chat
PILLAI_MODEL_PRO=deepseek/deepseek-chat

# ── Client config (only needed if client uses direct mode, not relay) ─────
# PILLAI_LICENSE_KEY=PILLAI-XXXX-XXXX-XXXX-XXXX

# ── Stripe (needed only when pricing page is live) ────────────────────────
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Optional tuning ───────────────────────────────────────────────────────
PILLAI_GRACE_DAYS=7
PILLAI_CACHE_DIR=~/.pill.ai
